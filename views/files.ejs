<!DOCTYPE html>
<html>
  <%- include partials/header.ejs %>
<body>

<div class="row p-0 m-0">
  <div class="col-md-12  p-0 m-0">
    <%- include partials/menu.ejs %>
  </div>
</div>

<div class="container-fluid p-4">

  <div class="row">
    <div class="col-sm-1"></div>

    <div class="col-sm-2"><h5>Listing files at <%= path %></h5></div>
    <div class="col-sm-1"><a href="/files?path=<%= path %>/..">../</a></div>

    <div class="col-sm-3">
    <h5>New folder</h5>
    <form method="post" action="directory/new">
      <input type="text" name="foldername" />
      <input type="hidden" value="<%= path %>" name="path">
      <input type="submit" class="btn btn-success">
    </form>
    </div>
      <div class="col-sm-4">

        <h5>Upload a file</h5>

        <form ref='uploadForm'
              id='uploadForm'
              action='files/upload'
              method='post'
              encType="multipart/form-data">

          <input type="hidden" value="<%= path %>" name="path">

          <input type="file" name="sampleFile" multiple />
          <input type="submit" value="Upload!" class="btn btn-success" />
        </form>
      </div>

    <div class="col-sm-1"></div>
  </div>
  <br>

  <div class="row">
    <div class="col-lg-1"></div>
    <div class="col-lg-10">

    <table class="table table-striped">
      <tr>
        <th>Name</th>
        <th>Preview</th>
        <th>Created</th>
        <th>Size</th>
        <th>Delete</th>

      </tr>

      <% files.forEach(function(file) { %>

        <% if (file.details.isFile) { %>

          <tr style="font-weight: bold">
            <td class="align-middle"><a href="/files/get?path=<%= file.path %>"><%= file.name %></a></td>

            <td class="align-middle">
              <% if (file.path.toLowerCase().endsWith('jpg') ||
                      file.path.toLowerCase().endsWith('jpeg') ||
                      file.path.toLowerCase().endsWith('png')) { %>

            <a href="/files/get?path=<%= file.path %>">
              <img src="/files/get/preview?path=<%= file.path %>"
                   class="img-fluid"
                   style="min-width: 150px"
                   alt="<%= file.path %>">
            </a>

              <% } %>

            </td>

            <td class="align-middle"><%= new Date(file.details.birthtime) %> </td>
            <td class="align-middle"><%= Math.round(file.details.size/1024/1024*100)/100 %> MB</td>

            <td>
              <form action='files/delete'
                    method='post'>

                <input type="hidden" value="<%= file.name %>" name="name">
                <input type="hidden" value="<%= path %>" name="path">

                <input type='submit' value='delete' class="btn btn-danger"/>
              </form>

            </td>
          </tr>
        <% } %>

          <% if (file.details.isDirectory) { %>

            <tr>
              <td class="align-middle"><a href="/files?path=<%= file.path %>"><%= file.name %></a></td>
              <td></td>
              <td class="align-middle"><%= new Date(file.details.birthtime) %> </td>
              <td class="align-middle"><%= file.details.size %></td>

          <td class="align-middle">
            <form action='directory/delete'
                  method='post'>

              <input type="hidden" value="<%= file.name %>" name="name">
              <input type="hidden" value="<%= path %>" name="path">

              <input type='submit' value='delete' class="btn btn-danger" />
            </form>

          </td>
        </tr>
          <% } %>





      <% }); %>
    </table>
    </div>

    <div class="col-lg-1"></div>

  </div>



</div>
</body>
</html>
