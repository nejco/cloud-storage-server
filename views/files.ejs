<!DOCTYPE html>
<html>
  <%- include partials/header.ejs %>
<body>

<div class="row p-0 m-0">
  <div class="col-md-12  p-0 m-0">
    <%- include partials/menu.ejs %>
  </div>
</div>

<div class="container-fluid p-4">

  <div class="row">

    <div class="col-md-2"><h5>Listing files at <%= path %></h5></div>
    <div class="col-md-2">
      <a href="/files?path=<%= path %>/..">
        <button type="button" class="btn btn-primary" style="width: 100px">Go ..</button>
      </a>
    </div>

    <div class="col-md-4">

      <form method="post" action="directory/new">
        <input type="hidden" value="<%= path %>" name="path">

        <div class="form-row">

            <div class="form-group col-sm-8">
              <input type="text" name="foldername" placeholder="folder name" class="form-control"/>
            </div>

            <div class="form-group col-sm-4">
              <input type="submit" class="btn btn-success" value="New folder" class="form-control">
            </div>


        </div>
      </form>


    </div>

      <div class="col-md-4s">

        <form ref='uploadForm'
              id='uploadForm'
              action='files/upload'
              method='post'
              encType="multipart/form-data">
          <input type="hidden" value="<%= path %>" name="path">

          <div class="form-row">
            <div class="form-group col-sm-8">
                <input type="file" class="custom-file-input" id="customFile" name="sampleFile" multiple>
                <label style="text-align: left" class="custom-file-label" for="customFile">Choose file</label>
            </div>
            <div class="form-group col-sm-4">
              <input type="submit" value="Upload!" class="btn btn-success" />
            </div>
          </div>


        </form>

      </div>

  </div>
  <br>

  <div class="row">
    <div class="col-lg-1"></div>
    <div class="col-lg-10">

    <table class="table table-striped">
      <tr>
        <th>Name</th>
        <th>Created</th>
        <th>Size</th>
        <th>Delete</th>
      </tr>

      <% files.forEach(function(file) { %>

        <% if (file.details.isFile) { %>

          <tr style="font-weight: bold; text-align: center">

            <td class="align-middle">
              <% if (file.name.toLowerCase().endsWith('jpg') ||
                      file.name.toLowerCase().endsWith('jpeg') ||
                      file.name.toLowerCase().endsWith('png')) { %>

            <a href="/files/get/<%= file.name %>?path=<%= file.path %>">
              <img src="/files/get/preview/<%= file.name %>?path=<%= file.path %>"
                   class="img-fluid"
                   style="min-width: 150px"
                   alt="<%= file.name %>">
            </a>

              <% } %>
                <br><a href="/files/get/<%= file.name %>?path=<%= file.path %>"><%= file.name %></a>
            </td>

            <td class="align-middle"><%= new Date(file.details.birthtime) %> </td>
            <td class="align-middle"><%= Math.round(file.details.size/1024/1024*100)/100 %> MB</td>

            <td>
              <form action='files/delete'
                    method='post'>

                <input type="hidden" value="<%= file.name %>" name="name">
                <input type="hidden" value="<%= path %>" name="path">

                <input type='submit' value='delete' class="btn btn-danger"/>
              </form>

            </td>
          </tr>
        <% } %>

          <% if (file.details.isDirectory) { %>

            <tr>
              <td class="align-middle"><a href="/files?path=<%= file.path %>/<%= file.name %>"><%= file.name %></a></td>
              <td class="align-middle"><%= new Date(file.details.birthtime) %> </td>
              <td class="align-middle"><%= file.details.size %></td>

          <td class="align-middle">
            <form action='directory/delete'
                  method='post'>

              <input type="hidden" value="<%= file.name %>" name="name">
              <input type="hidden" value="<%= path %>" name="path">

              <input type='submit' value='delete' class="btn btn-danger" />
            </form>

          </td>
        </tr>
          <% } %>





      <% }); %>
    </table>
    </div>

    <div class="col-lg-1"></div>

  </div>

  <div class="row">

  <div class="col">
  </div>

    <div class="col" style="text-align: center;">

    <% if(page > 1){ %>
        <a href="/files?path=<%= path %>&page=<%= page-1 %>">previous</a>
    <% } %>

    <%
      for(let i = 1 ; i<=numerOfPages ; i++){
        %>
        <a href="/files?path=<%= path %>&page=<%= i %>"
            <% if(page===i){ %>
                style="text-decoration: underline; font-weight: bold"
            <% } %>

        ><%= i %></a>
    <% } %>

        <% if(page+1 <= numerOfPages){ %>
            <a href="/files?path=<%= path %>&page=<%= page+1 %>">next</a>
        <% } %>



    </div>

    <div class="col">
    </div>
  </div>

</div>
</body>
</html>

