<!DOCTYPE html>
<html>
  <head>
    <title><%= title %></title>
    <link rel='stylesheet' href='/stylesheets/style.css' />
    <link rel='stylesheet' href='/css/bootstrap.css' />
    <script src="/javascripts/jquery-3.5.0.min.js"></script>
    <script src="/js/bootstrap.js"></script>


  </head>
  <body>
    <h1>Hi, <%= username %></h1>
    <p>Listing files at <%= path %></p>

    <a href="/files?path=<%= path %>/..">../</a><br/>


    <table class="table table-striped">
      <tr>
        <th>Name</th>
        <th>Preview</th>
        <th>Created</th>
        <th>Size</th>
        <th>Is file?</th>
        <th>Is dir?</th>
        <th>Delete</th>

      </tr>

      <% files.forEach(function(file) { %>

        <% if (file.details.isFile) { %>

          <tr style="font-weight: bold">
            <td><a href="/files/get?path=<%= file.path %>"><%= file.name %></a></td>

            <td>
              <% if (file.path.toLowerCase().endsWith('jpg') ||
                      file.path.toLowerCase().endsWith('jpeg') ||
                      file.path.toLowerCase().endsWith('png')) { %>

              <img src="/files/get/preview?path=<%= file.path %>" class="img-responsive" alt="Responsive image">

              <% } %>

            </td>

<!--              <a href="/files/get/preview?path=<%= file.path %>"><%= file.name %></a></td>-->
            <td><%= new Date(file.details.birthtime) %> </td>
            <td><%= file.details.size %></td>
            <td><%= file.details.isFile %></td>
            <td><%= file.details.isDirectory %></td>

            <td>
              <form action='files/delete'
                    method='post'>

                <input type="hidden" value="<%= file.name %>" name="name">
                <input type="hidden" value="<%= path %>" name="path">

                <input type='submit' value='delete' class="btn btn-danger"/>
              </form>

            </td>
          </tr>
        <% } %>

          <% if (file.details.isDirectory) { %>

            <tr>
              <td><a href="/files?path=<%= file.path %>"><%= file.name %></a></td>
              <td></td>
              <td><%= new Date(file.details.birthtime) %> </td>
              <td><%= file.details.size %></td>
              <td><%= file.details.isFile %></td>
              <td><%= file.details.isDirectory %></td>

          <td>
            <form action='directory/delete'
                  method='post'>

              <input type="hidden" value="<%= file.name %>" name="name">
              <input type="hidden" value="<%= path %>" name="path">

              <input type='submit' value='delete' class="btn btn-danger"/>
            </form>

          </td>
        </tr>
          <% } %>





      <% }); %>
    </table>


  <h1>New folder</h1>
  <form method="post" action="directory/new">
    New folder name <input type="text" name="foldername" />
    <input type="hidden" value="<%= path %>" name="path">

    <input type="submit" class="btn btn-success">
  </form>

    <h1>Upload a file</h1>

    <form ref='uploadForm'
          id='uploadForm'
          action='files/upload'
          method='post'
          encType="multipart/form-data">

      <input type="hidden" value="<%= path %>" name="path">

      <input type="file" name="sampleFile" multiple />
      <input type="submit" value="Upload!" class="btn btn-success" />
    </form>

  </body>
</html>
