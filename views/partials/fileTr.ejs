<tr>

    <td class="align-middle" style="text-align: center">
        <a href="/files/get/<%= encodeURIComponent(file.name) %>?path=<%= file.escapedPath %>">
            <%- include("./fileIcon.ejs") %>
        </a>
    </td>

    <td class="align-left text-secondary" style="font-size: smaller">
        <a  style="font-weight: bold;" href="/files/get/<%= encodeURIComponent(file.name) %>?path=<%= file.escapedPath %>"><%= file.name %></a><br>

        <%= new Date(file.details.birthtime).toDateString() %>
        <%= new Date(file.details.birthtime).toLocaleTimeString() %> -
        <%= Math.round(file.details.size/1024/1024*100)/100 %> MB


    </td>

    <td class="align-middle">
        <input type="checkbox"
               class="form-check-input position-static"
               id="<%= file.name %>"
               name="<%= file.name %>"
               form="deleteItem" />
    </td>
</tr>
