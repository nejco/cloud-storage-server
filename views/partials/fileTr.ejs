<tr>

    <td class="align-middle" style="text-align: center">
        <a href="/files/get/<%= file.name %>?path=<%= file.path %>">

        <% if (file.name.toLowerCase().endsWith('jpg') ||
                file.name.toLowerCase().endsWith('jpeg') ||
                file.name.toLowerCase().endsWith('png')) { %>

                <img src="/files/get/preview/<%= file.name %>?path=<%= file.path %>"
                     class="img-fluid"
                     style="min-width: 150px; max-height: 500px"
                     alt="<%= file.name %>">

        <% } else { %>
            <svg width="2em" height="2em" viewBox="0 0 16 16" class="bi bi-file-earmark" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                <path d="M4 0h5.5v1H4a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1V4.5h1V14a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V2a2 2 0 0 1 2-2z"/>
                <path d="M9.5 3V0L14 4.5h-3A1.5 1.5 0 0 1 9.5 3z"/>
            </svg>
        <% } %>
        </a>

    </td>

    <td class="align-left">
        <a  style="font-weight: bold" href="/files/get/<%= file.name %>?path=<%= file.path %>"><%= file.name %></a><br>

        <%= new Date(file.details.birthtime).toDateString() %>
        <%= new Date(file.details.birthtime).toLocaleTimeString() %> -

        <%= Math.round(file.details.size/1024/1024*100)/100 %> MB

    </td>




    <td>
        <form action='files/delete'
              method='post'>

            <input type="hidden" value="<%= file.name %>" name="name">
            <input type="hidden" value="<%= path %>" name="path">

            <input type='submit' value='delete' class="btn btn-danger"/>
        </form>

    </td>
</tr>
